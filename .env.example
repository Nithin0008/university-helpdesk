# ==============================================================================
# Environment Configuration Template
# Multilingual University Helpdesk (RAG Assistant)
# ==============================================================================
# Copy this file to .env and fill in your actual credentials:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env or paste your real API key into version control.
# ==============================================================================

# Google Gemini API Key (Obtain from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=

# Primary Gemini Answer Generation Model
# Default: gemini-3.8-flash (automatic failover to gemini-3.5-flash-lite and local fallback)
GEMINI_MODEL=gemini-3.8-flash

